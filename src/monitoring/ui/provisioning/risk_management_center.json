{
  "dashboard": {
    "title": "Risk Management Center Dashboard",
    "description": "Comprehensive risk monitoring and exposure tracking",
    "tags": ["risk", "management", "exposure", "var", "tokemfx"],
    "timezone": "UTC",
    "panels": [
      {
        "id": 1,
        "title": "Position Size Limits",
        "type": "bargauge",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
        "targets": [{
          "expr": "position_size_limit{instrument=~"$instrument"}",
          "legendFormat": "{{instrument}} Position %"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1.5},
                {"color": "red", "value": 2.5}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Value at Risk (VaR)",
        "type": "stat",
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
        "targets": [{
          "expr": "portfolio_var_95",
          "legendFormat": "95% VaR"
        }]
      },
      {
        "id": 3,
        "title": "Maximum Drawdown Tracking",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "targets": [{
          "expr": "portfolio_drawdown",
          "legendFormat": "Current Drawdown"
        }]
      },
      {
        "id": 4,
        "title": "Correlation Matrix",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "targets": [{
          "expr": "asset_correlations",
          "legendFormat": "Correlation"
        }]
      }
    ],
    "time": {"from": "now-7d", "to": "now"},
    "refresh": "30s",
    "templating": {
      "list": [{
        "name": "instrument",
        "type": "query",
        "query": "label_values(position_size_limit, instrument)",
        "label": "Instrument"
      }]
    }
  }
}
