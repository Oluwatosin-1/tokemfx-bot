{
  "dashboard": {
    "title": "Executive Overview Dashboard",
    "description": "Executive-level business intelligence and system KPIs",
    "tags": ["executive", "overview", "kpi", "business", "tokemfx"],
    "timezone": "UTC",
    "panels": [
      {
        "id": 1,
        "title": "Portfolio Performance Summary", 
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [{
          "expr": "portfolio_total_return",
          "legendFormat": "Total Return %"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "green", "value": 15}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "AI Confidence Overview",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [{
          "expr": "avg_ai_confidence",
          "legendFormat": "AI Confidence"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.6},
                {"color": "green", "value": 0.8}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "System Health Status",
        "type": "status-history",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
        "targets": [{
          "expr": "system_health_status{component=~"$component"}",
          "legendFormat": "{{component}} Status"
        }]
      },
      {
        "id": 4,
        "title": "Trading Activity Summary",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "daily_trades_count",
            "legendFormat": "Daily Trades"
          },
          {
            "expr": "win_rate_today",
            "legendFormat": "Win Rate %"
          },
          {
            "expr": "avg_trade_size",
            "legendFormat": "Avg Trade Size"
          }
        ]
      },
      {
        "id": 5,
        "title": "Risk Exposure Overview",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 12, "y": 6},
        "targets": [{
          "expr": "overall_portfolio_risk",
          "legendFormat": "Portfolio Risk %"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 2},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Market Conditions",
        "type": "table",
        "gridPos": {"h": 6, "w": 4, "x": 20, "y": 6},
        "targets": [{
          "expr": "market_volatility_index",
          "legendFormat": "Market Volatility"
        }]
      }
    ],
    "time": {"from": "now-1d", "to": "now"},
    "refresh": "5m",
    "templating": {
      "list": [{
        "name": "component",
        "type": "query", 
        "query": "label_values(system_health_status, component)",
        "label": "System Component"
      }]
    }
  }
}
