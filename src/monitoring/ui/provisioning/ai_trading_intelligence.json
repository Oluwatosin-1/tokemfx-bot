{
  "dashboard": {
    "title": "AI Trading Intelligence Dashboard",
    "description": "AI model performance, confidence tracking, and health monitoring",
    "tags": ["ai", "ml", "confidence", "model", "tokemfx"],
    "timezone": "UTC",
    "panels": [
      {
        "id": 1,
        "title": "AI Confidence Gauges",
        "type": "bargauge",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
        "targets": [{
          "expr": "ai_confidence_score{instrument=~\"$instrument\"}",
          "legendFormat": "{{instrument}} Confidence"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "orange", "value": 0.5},
                {"color": "yellow", "value": 0.7},
                {"color": "green", "value": 0.8}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Model Accuracy Trends",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [{
          "expr": "ai_model_accuracy{model=~\"$model\"}",
          "legendFormat": "{{model}} Accuracy %"
        }],
        "yAxes": [
          {"format": "percent", "label": "Accuracy"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Drift Detection Alerts",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 6},
        "targets": [{
          "expr": "ai_model_drift_detected",
          "legendFormat": "Model Drift Count"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Confidence Distribution",
        "type": "histogram",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
        "targets": [{
          "expr": "ai_confidence_distribution",
          "legendFormat": "Confidence Score"
        }]
      },
      {
        "id": 5,
        "title": "Pattern Recognition Success",
        "type": "bargauge",
        "gridPos": {"h": 6, "w": 8, "x": 12, "y": 10},
        "targets": [{
          "expr": "ai_pattern_recognition_rate{pattern_type=~\"$pattern\"}",
          "legendFormat": "{{pattern_type}} Accuracy"
        }]
      }
    ],
    "time": {"from": "now-7d", "to": "now"},
    "refresh": "15m",
    "templating": {
      "list": [
        {
          "name": "instrument",
          "type": "query",
          "query": "label_values(ai_confidence_score, instrument)",
          "label": "Instrument"
        },
        {
          "name": "model",
          "type": "query",
          "query": "label_values(ai_model_accuracy, model)",
          "label": "AI Model"
        },
        {
          "name": "pattern",
          "type": "query",
          "query": "label_values(ai_pattern_recognition_rate, pattern_type)",
          "label": "Pattern Type"
        }
      ]
    }
  }
}
